{
  "name": "authenticator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A local-only TOTP authenticator browser extension.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "zip": "pnpm build && V=$(node -p \"require('./package.json').version\") && rm -f authenticator-*.zip && cp LICENSE docs/THIRD_PARTY_LICENSES.md dist/ && cd dist && zip -qr ../authenticator-$V.zip . -x '*.map' && cd .. && ls -lh authenticator-$V.zip",
    "test": "vitest run",
    "test:watch": "vitest",
    "shots": "node scripts/shots/capture.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@types/chrome": "^0.0.287",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
